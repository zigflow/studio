{
  "name": "devcontainer",
  "image": "ghcr.io/mrsimonemms/devcontainers/full",
  "features": {
    "ghcr.io/mrsimonemms/devcontainers/air:1": {},
    "ghcr.io/mrsimonemms/devcontainers/cobra-cli:1": {},
    "ghcr.io/guiyomh/features/goreleaser:0": {},
    "ghcr.io/devcontainers-extra/features/temporal-cli:1": {},
    "ghcr.io/mrsimonemms/devcontainers/zigflow:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {}
    }
  },
  "postCreateCommand": {
    "bootstrap": "ln -s $PWD/.cobra.yaml $HOME/.cobra.yaml && if [ ! -f \"go.mod\" ]; then go mod init \"github.com/zigflow/studio\"; fi && if [ ! -f \"main.go\" ]; then cobra-cli init && go mod tidy; fi",
    "oapi-codegen": "go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@latest"
  },
  "containerEnv": {
    "GIT_REPO": "github.com/zigflow/studio"
  },
  "forwardPorts": [
    8080,
    8233
  ]
}
